{
  "name": "manatoo",
  "version": "0.1.0",
  "private": true,
  "description": "Custom Divoom AstroToo clockface workspace",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "editor": "npm --prefix tools/astrotoo-editor run dev -- --host 127.0.0.1",
    "build": "npm --prefix tools/astrotoo-editor run build && npm --prefix tools/mcp-divoom-lan run build",
    "device:info": "node scripts/device-info.mjs",
    "mcp": "node tools/mcp-divoom-lan/dist/index.js"
  },
  "engines": { "node": ">=20" }
}
