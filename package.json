{
  "name": "manatoo",
  "version": "0.1.0",
  "private": true,
  "description": "Custom Divoom AstroToo clockface workspace",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "editor": "npm --prefix tools/astrotoo-editor run dev -- --host 127.0.0.1",
    "build": "npm --prefix tools/astrotoo-editor run build && npm --prefix tools/mcp-divoom-lan run build",
    "device:info": "node scripts/device-info.mjs",
    "mcp": "node tools/mcp-divoom-lan/dist/index.js",
    "face:deploy": "node scripts/deploy-code-clock.mjs",
    "face:draw": "pwsh -File scripts/draw-code-clock.ps1 && node scripts/compile-code-clock.mjs",
    "face:sprites": "python scripts/build-clock-sprites.py",
    "publish:prepare": "node scripts/publish/prepare.mjs",
    "publish:check": "node scripts/publish/submit.mjs",
    "publish:submit": "node scripts/publish/submit.mjs --submit",
    "publish:status": "node scripts/publish/status.mjs",
    "test:publish": "node --test scripts/publish/publish.test.mjs",
    "review:watch": "node scripts/publish/watch-review.mjs",
    "review:schedule": "pwsh -File scripts/publish/schedule-review.ps1"
  },
  "engines": { "node": ">=20" }
}
